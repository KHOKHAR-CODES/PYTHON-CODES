    {
      "name": "Index Sample Document",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"document_name\": \"sample.txt\",\n  \"content\": \"FastAPI is a modern Python web framework for building APIs. It is built around Python type hints and provides automatic OpenAPI documentation.\\n\\nRetrieval-Augmented Generation, or RAG, combines information retrieved from an external knowledge source with a language model prompt. The retrieved context is used to ground the generated answer.\\n\\nEmbeddings represent text as vectors. A vector store can compare an embedded question with embedded document chunks to retrieve semantically related content.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/documents/index",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "documents",
            "index"
          ]
        }
      }
    },
    {
      "name": "Normal Question",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What is FastAPI?\",\n  \"top_k\": 3\n}"
        },
        "url": {
          "raw": "{{base_url}}/ask",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "ask"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('answer exists', () => pm.expect(body.answer).to.exist);",
              "pm.test('sources exists', () => pm.expect(body.sources).to.be.an('array'));",
              "pm.test('request_id exists', () => pm.expect(body.request_id).to.exist);"
            ]
          }
        }
      ]
    },
